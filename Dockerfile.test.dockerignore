# Ignore rules for the TEST image only (BuildKit picks <Dockerfile>.dockerignore).
# Same as .dockerignore but keeps tests/ so `docker run sf-pardot-mcp-tests` works.

# Environment and secrets
.env

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Virtual environments
.venv/
.venv*/
venv/

# Python packaging
*.egg-info/
dist/
build/

# Encrypted token data (runtime — created inside container)
data/
*.enc

# SSL certificates (local dev)
certs/
*.pem
*.key

# Internal docs
CLAUDE.md
.claude/

# Git
.git/
.gitignore

# OS files
.DS_Store

# Pytest
.pytest_cache/
