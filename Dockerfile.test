# Test runner — builds the project and runs all tests
# Usage:
#   docker build -f Dockerfile.test -t sf-pardot-mcp-tests .
#   docker run --rm sf-pardot-mcp-tests
#
# Run only unit tests (no server startup):
#   docker run --rm sf-pardot-mcp-tests python -m pytest tests/test_security.py -v
#
# Run only integration tests:
#   docker run --rm sf-pardot-mcp-tests python -m pytest tests/test_integration.py -v

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies + pytest (the dev dependency group)
COPY --from=ghcr.io/astral-sh/uv:0.11.17 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock uv.toml ./
RUN uv sync --locked --no-cache
ENV PATH="/app/.venv/bin:$PATH"

COPY . .

# Security: run as non-root user
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser \
    && chown -R appuser:appgroup /app
USER appuser

# Default: run all tests
CMD ["python", "-m", "pytest", "tests/", "-v", "--tb=short"]
